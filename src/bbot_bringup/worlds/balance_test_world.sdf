<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="balance_test_world">
    <!-- 物理引擎参数设置 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 必须的 Ignition Gazebo 系统插件 -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="ignition-gazebo-imu-system"
      name="ignition::gazebo::systems::Imu">
    </plugin>

    <!-- 环境光照 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- 基础平坦地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.85 1.0</ambient>
            <diffuse>0.82 0.82 0.85 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- 测试区 1：多梯度斜坡与过桥坡道 (Y > 2.0, 零台阶无缝过渡)          -->
    <!-- ================================================================= -->

    <!-- 1.1 5° 缓坡道 (绿色, x = 0.0, y 从 3.0 处无缝切入, 平台高 0.30m) -->
    <model name="slope_5deg">
      <static>true</static>
      <link name="link">
        <!-- 爬坡斜板: 宽 1.8m, 长 4.4m, 厚 0.10m, 下端入地实现零台阶 -->
        <collision name="ramp_collision">
          <pose>0.0 4.719 0.100 0.087266 0 0</pose>
          <geometry>
            <box>
              <size>1.8 4.40 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ramp_visual">
          <pose>0.0 4.719 0.100 0.087266 0 0</pose>
          <geometry>
            <box>
              <size>1.8 4.40 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.65 0.25 1.0</ambient>
            <diffuse>0.15 0.65 0.25 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>

        <!-- 坡顶平坦驻留台: 宽 1.8m, 长 2.5m, 高 0.30m -->
        <collision name="platform_collision">
          <pose>0.0 7.679 0.150 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 2.5 0.30</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="platform_visual">
          <pose>0.0 7.679 0.150 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 2.5 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.55 0.20 1.0</ambient>
            <diffuse>0.12 0.55 0.20 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 1.2 10° 中坡道 (黄色, x = 2.2, y 从 3.0 处无缝切入, 平台高 0.50m) -->
    <model name="slope_10deg">
      <static>true</static>
      <link name="link">
        <collision name="ramp_collision">
          <pose>2.2 4.426 0.201 0.174533 0 0</pose>
          <geometry>
            <box>
              <size>1.8 3.80 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ramp_visual">
          <pose>2.2 4.426 0.201 0.174533 0 0</pose>
          <geometry>
            <box>
              <size>1.8 3.80 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.65 0.10 1.0</ambient>
            <diffuse>0.85 0.65 0.10 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>

        <!-- 坡顶平坦驻留台 -->
        <collision name="platform_collision">
          <pose>2.2 7.086 0.250 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 2.5 0.50</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="platform_visual">
          <pose>2.2 7.086 0.250 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 2.5 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.55 0.08 1.0</ambient>
            <diffuse>0.75 0.55 0.08 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 1.3 15° 陡坡道 (红色, x = 4.4, y 从 3.0 处无缝切入, 平台高 0.60m) -->
    <model name="slope_15deg">
      <static>true</static>
      <link name="link">
        <collision name="ramp_collision">
          <pose>4.4 4.132 0.252 0.261799 0 0</pose>
          <geometry>
            <box>
              <size>1.8 3.20 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.3</mu><mu2>1.3</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ramp_visual">
          <pose>4.4 4.132 0.252 0.261799 0 0</pose>
          <geometry>
            <box>
              <size>1.8 3.20 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.22 0.20 1.0</ambient>
            <diffuse>0.85 0.22 0.20 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>

        <!-- 坡顶平坦驻留台 -->
        <collision name="platform_collision">
          <pose>4.4 6.489 0.300 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 2.5 0.60</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.3</mu><mu2>1.3</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="platform_visual">
          <pose>4.4 6.489 0.300 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 2.5 0.60</size>
            </box>
          </geometry>
          <material>
            <ambient>0.70 0.18 0.15 1.0</ambient>
            <diffuse>0.70 0.18 0.15 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 1.4 过桥坡道 (青色, x = -2.2, 上坡 8° -> 平台 0.35m -> 下坡 8°) -->
    <model name="bridge_overpass">
      <static>true</static>
      <link name="link">
        <!-- 上坡: y 从 3.0 处无缝切入 -->
        <collision name="up_ramp_collision">
          <pose>-2.2 4.252 0.125 0.139626 0 0</pose>
          <geometry>
            <box>
              <size>1.8 3.30 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="up_ramp_visual">
          <pose>-2.2 4.252 0.125 0.139626 0 0</pose>
          <geometry>
            <box>
              <size>1.8 3.30 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.60 0.70 1.0</ambient>
            <diffuse>0.15 0.60 0.70 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>

        <!-- 桥面平坦区: y: 5.49 ~ 7.49 -->
        <collision name="deck_collision">
          <pose>-2.2 6.490 0.175 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 2.0 0.350</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="deck_visual">
          <pose>-2.2 6.490 0.175 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 2.0 0.350</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.48 0.58 1.0</ambient>
            <diffuse>0.12 0.48 0.58 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>

        <!-- 下坡: y 从 7.49 处无缝下降至地面 9.98 -->
        <collision name="down_ramp_collision">
          <pose>-2.2 8.728 0.125 -0.139626 0 0</pose>
          <geometry>
            <box>
              <size>1.8 3.30 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="down_ramp_visual">
          <pose>-2.2 8.728 0.125 -0.139626 0 0</pose>
          <geometry>
            <box>
              <size>1.8 3.30 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.60 0.70 1.0</ambient>
            <diffuse>0.15 0.60 0.70 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- 测试区 2：减速带与冲击台阶 (X in [-4.5, -6.5])                    -->
    <!-- ================================================================= -->

    <!-- 2.1 平滑圆弧减速带 (半入地圆柱实现平滑切入与真实冲击) -->
    <model name="speed_bumps_lane">
      <static>true</static>
      <link name="link">
        <!-- 减速带 1: 1.5 cm 凸起弧面 (圆柱 R=0.30m, 中心 z=-0.285m) -->
        <collision name="bump_1_5cm_coll">
          <pose>-4.5 0.0 -0.285 0 1.5707963 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="bump_1_5cm_vis">
          <pose>-4.5 0.0 -0.285 0 1.5707963 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.50 0.90 1.0</ambient>
            <diffuse>0.20 0.50 0.90 1.0</diffuse>
          </material>
        </visual>

        <!-- 减速带 2: 3.0 cm 凸起弧面 (圆柱 R=0.30m, 中心 z=-0.270m) -->
        <collision name="bump_3cm_coll">
          <pose>-4.5 2.0 -0.270 0 1.5707963 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="bump_3cm_vis">
          <pose>-4.5 2.0 -0.270 0 1.5707963 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.50 0.10 1.0</ambient>
            <diffuse>0.95 0.50 0.10 1.0</diffuse>
          </material>
        </visual>

        <!-- 减速带 3: 4.5 cm 凸起弧面 (圆柱 R=0.35m, 中心 z=-0.305m) -->
        <collision name="bump_4_5cm_coll">
          <pose>-4.5 4.0 -0.305 0 1.5707963 0</pose>
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="bump_4_5cm_vis">
          <pose>-4.5 4.0 -0.305 0 1.5707963 0</pose>
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.20 0.20 1.0</ambient>
            <diffuse>0.85 0.20 0.20 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2.2 连续波浪凸起路面 (Rumble Strip, 通道 x = -6.5, 圆弧截面 1.5cm) -->
    <model name="rumble_strip">
      <static>true</static>
      <link name="link">
        <collision name="r_bump_1_coll"><pose>-6.5 -0.8 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="r_bump_1_vis"><pose>-6.5 -0.8 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry><material><ambient>0.4 0.4 0.8 1.0</ambient><diffuse>0.4 0.4 0.8 1.0</diffuse></material></visual>

        <collision name="r_bump_2_coll"><pose>-6.5 -0.4 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="r_bump_2_vis"><pose>-6.5 -0.4 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry><material><ambient>0.4 0.4 0.8 1.0</ambient><diffuse>0.4 0.4 0.8 1.0</diffuse></material></visual>

        <collision name="r_bump_3_coll"><pose>-6.5 0.0 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="r_bump_3_vis"><pose>-6.5 0.0 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry><material><ambient>0.4 0.4 0.8 1.0</ambient><diffuse>0.4 0.4 0.8 1.0</diffuse></material></visual>

        <collision name="r_bump_4_coll"><pose>-6.5 0.4 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="r_bump_4_vis"><pose>-6.5 0.4 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry><material><ambient>0.4 0.4 0.8 1.0</ambient><diffuse>0.4 0.4 0.8 1.0</diffuse></material></visual>

        <collision name="r_bump_5_coll"><pose>-6.5 0.8 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="r_bump_5_vis"><pose>-6.5 0.8 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry><material><ambient>0.4 0.4 0.8 1.0</ambient><diffuse>0.4 0.4 0.8 1.0</diffuse></material></visual>

        <collision name="r_bump_6_coll"><pose>-6.5 1.2 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="r_bump_6_vis"><pose>-6.5 1.2 -0.185 0 1.5707963 0</pose><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry><material><ambient>0.4 0.4 0.8 1.0</ambient><diffuse>0.4 0.4 0.8 1.0</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- 测试区 3：蛇形绕桩与静态障碍巷道 (X in [6.0, 9.0])                 -->
    <!-- ================================================================= -->

    <!-- 3.1 蛇形避障桩阵列 (Slalom Poles, 橙色柱群, 半径 0.12m, 高 0.8m) -->
    <model name="slalom_course">
      <static>true</static>
      <link name="link">
        <collision name="pole_1_coll"><pose>7.0 -2.0 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="pole_1_vis"><pose>7.0 -2.0 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1.0</ambient><diffuse>0.95 0.45 0.05 1.0</diffuse></material></visual>

        <collision name="pole_2_coll"><pose>6.0 -0.6 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="pole_2_vis"><pose>6.0 -0.6 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1.0</ambient><diffuse>0.95 0.45 0.05 1.0</diffuse></material></visual>

        <collision name="pole_3_coll"><pose>7.0 0.8 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="pole_3_vis"><pose>7.0 0.8 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1.0</ambient><diffuse>0.95 0.45 0.05 1.0</diffuse></material></visual>

        <collision name="pole_4_coll"><pose>6.0 2.2 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="pole_4_vis"><pose>6.0 2.2 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1.0</ambient><diffuse>0.95 0.45 0.05 1.0</diffuse></material></visual>

        <collision name="pole_5_coll"><pose>7.0 3.6 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="pole_5_vis"><pose>7.0 3.6 0.4 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.45 0.05 1.0</ambient><diffuse>0.95 0.45 0.05 1.0</diffuse></material></visual>
      </link>
    </model>

    <!-- 3.2 狭窄障碍通道与静态箱体 (深灰色方箱) -->
    <model name="barrier_blocks">
      <static>true</static>
      <link name="link">
        <collision name="box_1_coll"><pose>8.8 -1.5 0.3 0 0 0</pose><geometry><box><size>0.6 0.8 0.6</size></box></geometry></collision>
        <visual name="box_1_vis"><pose>8.8 -1.5 0.3 0 0 0</pose><geometry><box><size>0.6 0.8 0.6</size></box></geometry><material><ambient>0.3 0.35 0.4 1.0</ambient><diffuse>0.3 0.35 0.4 1.0</diffuse></material></visual>

        <collision name="box_2_coll"><pose>8.8 1.0 0.3 0 0 0</pose><geometry><box><size>0.6 1.0 0.6</size></box></geometry></collision>
        <visual name="box_2_vis"><pose>8.8 1.0 0.3 0 0 0</pose><geometry><box><size>0.6 1.0 0.6</size></box></geometry><material><ambient>0.3 0.35 0.4 1.0</ambient><diffuse>0.3 0.35 0.4 1.0</diffuse></material></visual>

        <collision name="box_3_coll"><pose>8.8 3.5 0.3 0 0 0</pose><geometry><box><size>0.6 0.8 0.6</size></box></geometry></collision>
        <visual name="box_3_vis"><pose>8.8 3.5 0.3 0 0 0</pose><geometry><box><size>0.6 0.8 0.6</size></box></geometry><material><ambient>0.3 0.35 0.4 1.0</ambient><diffuse>0.3 0.35 0.4 1.0</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- 测试区 4：单边高差扰动与跳跃台阶 (Y < -2.0)                       -->
    <!-- ================================================================= -->

    <!-- 4.1 单边轮凸起扰动带 (紫色, 圆弧切面平滑进入, 测试 Roll 稳定性) -->
    <!-- 轮间距 0.364m, 车身在 x=0 时左右轮位于 x=±0.182m -->
    <model name="asymmetric_bumps">
      <static>true</static>
      <link name="link">
        <!-- 4.1.1 左轮单侧 3cm 凸起圆弧 (y = -3.0 ~ -5.0) -->
        <collision name="left_wheel_bump_coll">
          <pose>-0.182 -4.0 -0.270 1.5707963 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="left_wheel_bump_vis">
          <pose>-0.182 -4.0 -0.270 1.5707963 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.60 0.25 0.75 1.0</ambient>
            <diffuse>0.60 0.25 0.75 1.0</diffuse>
          </material>
        </visual>

        <!-- 4.1.2 右轮单侧 4cm 凸起圆弧 (y = -6.0 ~ -8.0) -->
        <collision name="right_wheel_bump_coll">
          <pose>0.182 -7.0 -0.260 1.5707963 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="right_wheel_bump_vis">
          <pose>0.182 -7.0 -0.260 1.5707963 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.60 0.25 0.75 1.0</ambient>
            <diffuse>0.60 0.25 0.75 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4.2 阶梯跳跃测试台 (通道 x = -2.5, y < -3.0, 配合跳跃控制器) -->
    <model name="jump_steps">
      <static>true</static>
      <link name="link">
        <!-- 8cm 台阶 (低高度跳跃) -->
        <collision name="step_8cm_coll">
          <pose>-2.5 -4.0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 1.5 0.08</size>
            </box>
          </geometry>
        </collision>
        <visual name="step_8cm_vis">
          <pose>-2.5 -4.0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 1.5 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.45 0.55 1.0</ambient>
            <diffuse>0.35 0.45 0.55 1.0</diffuse>
          </material>
        </visual>

        <!-- 15cm 台阶 (中高度跳跃) -->
        <collision name="step_15cm_coll">
          <pose>-2.5 -6.0 0.075 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 1.5 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="step_15cm_vis">
          <pose>-2.5 -6.0 0.075 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 1.5 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.28 0.38 0.48 1.0</ambient>
            <diffuse>0.28 0.38 0.48 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
